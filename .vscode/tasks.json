{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve",
      "detail": "Static server on http://127.0.0.1:8000 (tools/serve.py: no caching, so a reload always shows the files on disk)",
      "type": "shell",
      "command": "python",
      "args": ["-u", "tools/serve.py", "8000"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "serve",
        "pattern": { "regexp": "^$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Serving HTTP",
          "endsPattern": "Serving HTTP"
        }
      }
    }
  ]
}
